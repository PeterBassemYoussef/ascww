[Unit]
Description=ASCWW Frontend Node Server
Documentation=https://github.com/your-repo/wiki
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ascww

# البيئة الإنتاجية
Environment=NODE_ENV=production
Environment=PORT=3000

# إعدادات الـ Backend API
Environment=BACKEND_BASE_URL=https://backend.ascww.org

# Vite environment variables
Environment=VITE_API_BASE_URL=/api
Environment=VITE_SITE_URL=https://your-domain.com

# اختياري: أضف إذا كنت تستخدم .env file
EnvironmentFile=/var/www/ascww/.env

# تشغيل الـ server
ExecStart=/usr/bin/node server.js

# إعادة التشغيل التلقائية
Restart=always
RestartSec=5

# حدود الموارد
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ascww

# مهلة الإيقاف
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
